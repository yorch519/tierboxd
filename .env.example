# Copy this file to `.env` and fill in the values. Never commit the real `.env`.
# On Vercel, set these in Project Settings -> Environment Variables instead.

# TMDB API key (v3 auth). Required by the serverless proxy.
TMDB_API_KEY=

# Upstash Redis (REST). Required on Vercel for per-IP rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: requests per minute per IP when using the server key (default 600).
RATE_LIMIT_PER_MIN=600
